# 환경에 직접 주입하세요. 이 파일을 자동으로 읽지는 않습니다. (EC2는 ~/app/ai.env, 로컬 compose는 ai/.env)
INTERNAL_API_KEY=replace-with-internal-service-key
OPENAI_API_KEY=replace-with-provider-key
# 공급자/계정이 실제 지원하는 API 모델명을 지정합니다. 생성과 검색 관련성 판단에 같이 씁니다.
AI_MODEL=gpt-6-luna
AI_DATA_DIR=./ai_data
AI_TENANT_SCOPE=backend
AI_MAX_OUTPUT_TOKENS=16000
# 백엔드와 새 응답 계약 합의 후에만 활성화합니다.
AI_ENABLE_V2_ANALYSES=false
# 지식 문서 검색 라우터. 켜면 백엔드 .env의 AI_SEARCH_ENABLED=true도 같이 켭니다.
AI_ENABLE_SEARCH=false
EMBEDDING_MODEL=text-embedding-3-small
# 문서 관계도 라우터. 켜면 백엔드 .env의 AI_RELATIONS_ENABLED=true도 같이 켭니다. 임베딩은 검색과 같은 EMBEDDING_MODEL을 씁니다.
AI_ENABLE_RELATIONS=false
# 관계도 연결 설정 (AI 담당 기본값. 바꾸면 모든 공간의 관계도를 새로 계산합니다)
RELATION_THRESHOLD=0.48
RELATION_NEIGHBORS=3
RELATION_MODE=mutual
RELATION_RESOLUTION=1.0
# 한 공간에서 관계도에 넣을 수 있는 최대 문서 수·본문 구간 수 (넘으면 관계도가 413으로 막힘)
RELATION_MAX_DOCUMENTS=200
RELATION_MAX_CHUNKS=512
# 다른 OpenAI 호환 공급자 사용 시에만 지정:
# OPENAI_BASE_URL=https://your-provider.example/v1
# 임베딩만 다른 공급자를 쓸 때만 지정:
# EMBEDDING_BASE_URL=https://embedding-provider.example/v1
# EMBEDDING_API_KEY=replace-with-embedding-key