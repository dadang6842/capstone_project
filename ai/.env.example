# 환경에 직접 주입하세요. 이 파일을 자동으로 읽지는 않습니다.
INTERNAL_API_KEY=replace-with-internal-service-key
OPENAI_API_KEY=replace-with-provider-key
# 공급자/계정이 실제 지원하는 API 모델명을 지정합니다.
AI_MODEL=gpt-6-luna
AI_DATA_DIR=./ai_data
AI_TENANT_SCOPE=backend
AI_MAX_OUTPUT_TOKENS=16000
# 백엔드와 새 응답 계약 합의 후에만 활성화합니다.
AI_ENABLE_V2_ANALYSES=false
# 다른 OpenAI 호환 공급자 사용 시에만 지정:
# OPENAI_BASE_URL=https://your-provider.example/v1
